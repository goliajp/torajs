target/
node_modules/
*.swp
.DS_Store

# tc39/test262 — clone for the test262 runner; >100 MB and not part
# of torajs source. Grab via:
#   git clone --depth 1 https://github.com/tc39/test262 vendor/test262
vendor/

# .claude/ is per-developer (synced via `devops dotclaude sync torajs`),
# never committed.  Per CLAUDE.md: dotclaude policy for sibling projects.
.claude/

# Ad-hoc binaries from go run / probe scripts in repo root
/main
/mandel_split2

# Bun's `bun build --compile` leaves these cache files wherever it ran.
# Bench harness invokes it from the workspace root, so they land here.
.*.bun-build

# Per-developer IDE config (nudo)
.nudo.toml

# hardev — local development tooling and its data, not part of the product
hardev/

# python bytecode caches (cluster_incompat.py et al)
__pycache__/
*.pyc

# per-rotation probe scratch (plan-state cites `scratchpad/pNNN/` as the
# local record of a rotation's probes; the files themselves are throwaway
# and their presence would mark every stamp `-dirty`)
scratchpad/
